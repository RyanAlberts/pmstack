# pmstack source repo .gitignore

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.python-version
.venv/
venv/

# Local Claude Code state that should never leak into a public repo
.claude/settings.local.json
.claude/projects/
.claude/worktrees/

# Credentials
.env
.env.*
*.pem
*.key
credentials.json

# Browser tests: Playwright installs and results
tests/e2e/node_modules/
tests/e2e/test-results/

# Eval Studio run files in any folder: the write lock and the note about a running server
**/pmstack/.lock
**/pmstack/.studio.json

# Made when you run the README's quickstart (node bin/pmstack.mjs studio examples/quickstart)
examples/quickstart/pmstack/project.json
examples/quickstart/pmstack/suggestions.json

# Made by the folder-mode tests
tests/fixtures/folder/pmstack/

# Made when you run the README command line examples from the repo root
/quickstart.json
/clinic.json
/report.md
/report-funnel.svg
/regression.jsonl
/checks.json
